<Project Sdk="Microsoft.NET.Sdk">

  <!--
    My Summer Frames: DLSS, FSR, frame generation and Reflex for My Summer Car, the MSCLoader side (Mods\MySummerFrames.dll).
    The D3D11 / D3D12 / NGX / FSR work is in the native core (..\core, msf_core.dll). Built against the real game only: -p:ManagedDir=<game>\mysummercar_Data\Managed
  -->

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>MySummerFrames</AssemblyName>
    <RootNamespace>MySummerFrames</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0612</NoWarn>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MSCLoader"><HintPath>$(ManagedDir)\MSCLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core" />
  </ItemGroup>

  <!-- The mod list icon (MsfMod.Icon); made from banner_github.png by scripts\analysis\make_icon.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\icon.png"><LogicalName>MySummerFrames.Resources.icon.png</LogicalName></EmbeddedResource>
  </ItemGroup>

  <Target Name="RequireGame" BeforeTargets="CoreCompile">
    <Error Text="[MSF] Pass -p:ManagedDir=&lt;game&gt;\mysummercar_Data\Managed" Condition=" '$(ManagedDir)' == '' Or !Exists('$(ManagedDir)\UnityEngine.dll') Or !Exists('$(ManagedDir)\MSCLoader.dll') " />
  </Target>

</Project>
