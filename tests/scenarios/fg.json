{
  "Name": "msf-fg",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "DLSS frame generation through the D3D12 bridge: off, 2x, 2x while turning (dump of previous / generated / current), 3x, 4x, 6x, DLAA + 2x, then a drive with 2x and off. FrameCounter counts the shown images." },
    { "Op": "console", "Text": "msf off" },
    { "Op": "console", "Text": "msf status" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-5.0, 1.0, 3.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "yard-off", "Seconds": 8 },

    { "Op": "log", "Text": "the bridge alone first (real frames through the D3D12 swap chain, no DLSS-G)" },
    { "Op": "console", "Text": "msf fg gen off" },
    { "Op": "console", "Text": "msf fg 2" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "console", "Text": "msf status" },
    { "Op": "measure", "Label": "yard-bridge", "Seconds": 8 },
    { "Op": "console", "Text": "msf fg gen on" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "console", "Text": "msf status" },
    { "Op": "measure", "Label": "yard-fg2", "Seconds": 8 },
    { "Op": "console", "Text": "msf fg dump" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf spin 30 0" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "console", "Text": "msf fg dump" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf fg hudless off" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf fg dump" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf fg hudless on" },
    { "Op": "console", "Text": "msf spin 0 0" },
    { "Op": "console", "Text": "msf status" },

    { "Op": "console", "Text": "msf fg 3" },
    { "Op": "measure", "Label": "yard-fg3", "Seconds": 8 },
    { "Op": "console", "Text": "msf fg 4" },
    { "Op": "measure", "Label": "yard-fg4", "Seconds": 8 },
    { "Op": "console", "Text": "msf fg 6" },
    { "Op": "measure", "Label": "yard-fg6", "Seconds": 8 },
    { "Op": "console", "Text": "msf fg 2" },
    { "Op": "console", "Text": "msf on" },
    { "Op": "measure", "Label": "yard-dlaa-fg2", "Seconds": 8 },
    { "Op": "console", "Text": "msf status" },
    { "Op": "console", "Text": "msf off" },

    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "measure", "Label": "drive-fg2", "Seconds": 8 },
    { "Op": "console", "Text": "msf fg dump" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf fg off" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "drive-off", "Seconds": 8 },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "console", "Text": "msf status" },
    { "Op": "quit" }
  ]
}
