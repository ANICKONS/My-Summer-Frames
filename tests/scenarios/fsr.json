{
  "Name": "msf-fsr",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "AMD FSR: 1) the upscaler with the runtime's input checks, every FSR mode (FPS, screenshot), the jitter directions; 2) FSR frame generation with DLAA, with FSR Quality, live switches FSR FG <-> DLSS FG; 3) a drive in FSR Performance with FSR FG." },
    { "Op": "console", "Text": "msf status" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-5.0, 1.0, 3.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 4 },

    { "Op": "log", "Text": "=== 1. FSR upscaler" },
    { "Op": "console", "Text": "msf fsr debug on" },
    { "Op": "console", "Text": "msf fsr quality" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "console", "Text": "msf spin 20 0" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf spin 0 0" },
    { "Op": "console", "Text": "msf fsr debug off" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf status" },
    { "Op": "console", "Text": "msf mode off" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "off", "Seconds": 6 },
    { "Op": "screenshot", "Label": "off" },
    { "Op": "console", "Text": "msf mode dlaa" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "dlaa", "Seconds": 6 },
    { "Op": "screenshot", "Label": "dlaa" },
    { "Op": "console", "Text": "msf fsr native" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "fsr-native", "Seconds": 6 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "fsr-native" },
    { "Op": "console", "Text": "msf fsr quality" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "fsr-quality", "Seconds": 6 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "fsr-quality" },
    { "Op": "console", "Text": "msf fsr balanced" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "fsr-balanced", "Seconds": 6 },
    { "Op": "screenshot", "Label": "fsr-balanced" },
    { "Op": "console", "Text": "msf fsr performance" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "fsr-performance", "Seconds": 6 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "fsr-performance" },
    { "Op": "console", "Text": "msf fsr ultra" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "fsr-ultra", "Seconds": 6 },
    { "Op": "screenshot", "Label": "fsr-ultra" },
    { "Op": "console", "Text": "msf fsr quality" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf shots fsrq" },
    { "Op": "wait", "Seconds": 20 },
    { "Op": "console", "Text": "msf status" },

    { "Op": "log", "Text": "=== 2. FSR frame generation" },
    { "Op": "console", "Text": "msf mode dlaa" },
    { "Op": "console", "Text": "msf fg fsr" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "measure", "Label": "dlaa-fsrfg", "Seconds": 8 },
    { "Op": "screenshot", "Label": "dlaa-fsrfg" },
    { "Op": "console", "Text": "msf status" },
    { "Op": "console", "Text": "msf spin 30 0" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "dlaa-fsrfg-turning", "Seconds": 6 },
    { "Op": "console", "Text": "msf spin 0 0" },
    { "Op": "console", "Text": "msf fsr quality" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "fsrq-fsrfg", "Seconds": 8 },
    { "Op": "screenshot", "Label": "fsrq-fsrfg" },
    { "Op": "console", "Text": "msf fg 2" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "fsrq-dlssfg2", "Seconds": 6 },
    { "Op": "screenshot", "Label": "fsrq-dlssfg2" },
    { "Op": "console", "Text": "msf fg fsr" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "fsrq-fsrfg-again", "Seconds": 6 },
    { "Op": "console", "Text": "msf mode quality" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "measure", "Label": "dlssq-fsrfg", "Seconds": 6 },
    { "Op": "console", "Text": "msf status" },
    { "Op": "console", "Text": "msf fg off" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "screenshot", "Label": "fg-off" },

    { "Op": "log", "Text": "=== 3. Drive (FSR Performance + FSR FG)" },
    { "Op": "console", "Text": "msf fsr performance" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "measure", "Label": "drive-fsr-performance", "Seconds": 6 },
    { "Op": "screenshot", "Label": "drive-fsr-performance" },
    { "Op": "console", "Text": "msf fg fsr" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "drive-fsrp-fsrfg", "Seconds": 8 },
    { "Op": "screenshot", "Label": "drive-fsrp-fsrfg" },
    { "Op": "console", "Text": "msf fg off" },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "console", "Text": "msf status" },
    { "Op": "quit" }
  ]
}
