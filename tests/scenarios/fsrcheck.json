    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-5.0, 1.0, 3.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "console", "Text": "msf cameras gui" },
    { "Op": "console", "Text": "msf mode dlaa" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "dlaa", "Seconds": 8 },
    { "Op": "screenshot", "Label": "dlaa" },
    { "Op": "console", "Text": "msf mode quality" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "dlss-quality", "Seconds": 8 },
    { "Op": "screenshot", "Label": "dlss-quality" },
