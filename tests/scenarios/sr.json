{
  "Name": "msf-sr",
  "SettleSeconds": 10,
  "LoadTimeoutSeconds": 600,
  "Steps": [
    { "Op": "log", "Text": "DLSS Super Resolution and Reflex at the run's resolution. 1) Reflex off / on / boost with DLAA next to the Satsuma: FPS and the driver's latency report. 2) Every DLSS mode: FPS, report (GPU busy), screenshot. 3) Upscaling + frame generation dump. 4) A drive in Performance with the reprojection test." },
    { "Op": "console", "Text": "msf mode dlaa" },
    { "Op": "console", "Text": "msf reflex off" },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-5.0, 1.0, 3.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 5 },

    { "Op": "log", "Text": "=== 1. Reflex (DLAA)" },
    { "Op": "measure", "Label": "reflex-off", "Seconds": 10 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "console", "Text": "msf reflex on" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "reflex-on", "Seconds": 10 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "console", "Text": "msf reflex boost" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "reflex-boost", "Seconds": 10 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "console", "Text": "msf status" },

    { "Op": "log", "Text": "=== 2. DLSS modes (Reflex on)" },
    { "Op": "console", "Text": "msf reflex on" },
    { "Op": "console", "Text": "msf mode off" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "mode-off", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "mode-off" },
    { "Op": "console", "Text": "msf mode dlaa" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "mode-dlaa", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "mode-dlaa" },
    { "Op": "console", "Text": "msf mode quality" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "mode-quality", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "mode-quality" },
    { "Op": "console", "Text": "msf status" },
    { "Op": "console", "Text": "msf mode balanced" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "mode-balanced", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "mode-balanced" },
    { "Op": "console", "Text": "msf mode performance" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "mode-performance", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "mode-performance" },
    { "Op": "console", "Text": "msf mode ultra" },
    { "Op": "wait", "Seconds": 3 },
    { "Op": "measure", "Label": "mode-ultra", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "mode-ultra" },
    { "Op": "console", "Text": "msf mode quality" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf shots quality" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf status" },

    { "Op": "log", "Text": "=== 3. Quality + frame generation 2x" },
    { "Op": "console", "Text": "msf fg 2" },
    { "Op": "wait", "Seconds": 5 },
    { "Op": "measure", "Label": "quality-fg2", "Seconds": 8 },
    { "Op": "console", "Text": "msf spin 30 0" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf fg dump" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "console", "Text": "msf spin 0 0" },
    { "Op": "console", "Text": "msf fg off" },
    { "Op": "wait", "Seconds": 2 },

    { "Op": "log", "Text": "=== 4. Drive (Performance)" },
    { "Op": "console", "Text": "msf mode performance" },
    { "Op": "placecar", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)", "Local": true, "Pos": [-3.0, 1.0, 0.0], "Target": "SATSUMA(557kg, 248)" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "teleport", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Pos": [0.0, 0.0, 0.0] },
    { "Op": "look", "Target": "SATSUMA(557kg, 248)", "Pitch": -3 },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/PlayerTrigger/DriveTrigger", "Fsm": "PlayerTrigger", "Event": "Key DOWN" },
    { "Op": "wait", "Seconds": 4 },
    { "Op": "look", "Pitch": -3 },
    { "Op": "fsmstate", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Text": "Check key" },
    { "Op": "fsmset", "Path": "SATSUMA(557kg, 248)/MiscParts/HandBrake/handbrake(xxxxx)/handbrake lever", "Fsm": "Use", "Var": "KnobPos", "Value": "0" },
    { "Op": "wait", "Seconds": 6 },
    { "Op": "fsmevent", "Path": "SATSUMA(557kg, 248)/Dashboard/Steering/steering_column2/IgnitionSatsuma", "Fsm": "UseNew", "Event": "FINISHED" },
    { "Op": "wait", "Seconds": 1 },
    { "Op": "autodrive", "Target": "SATSUMA(557kg, 248)", "Path": "TRAFFIC/Routes/DirtRoad", "Max": 2233, "Last": 2483, "Speed": 45 },
    { "Op": "wait", "Seconds": 15 },
    { "Op": "console", "Text": "msf mvtest on" },
    { "Op": "measure", "Label": "drive-performance", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "drive-performance" },
    { "Op": "console", "Text": "msf mvtest off" },
    { "Op": "console", "Text": "msf mode dlaa" },
    { "Op": "wait", "Seconds": 2 },
    { "Op": "measure", "Label": "drive-dlaa", "Seconds": 8 },
    { "Op": "console", "Text": "msf reflex stats" },
    { "Op": "screenshot", "Label": "drive-dlaa" },
    { "Op": "autodrivestop", "Text": "now" },
    { "Op": "console", "Text": "msf status" },
    { "Op": "quit" }
  ]
}
